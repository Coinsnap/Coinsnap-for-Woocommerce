{
  "name": "coinsnap/coinsnap-for-woocommerce",
  "description": "Coinsnap payment gateway for WooCommerce.",
  "type": "project",
  "license": "GPL-3.0-or-later",
  "require": {
  },
  "require-dev": {
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
    "friendsofphp/php-cs-fixer": "^3.68",
    "php-stubs/woocommerce-stubs": "^8.9",
    "php-stubs/wordpress-stubs": "^6.7",
    "phpstan/extension-installer": "^1.4",
    "phpstan/phpstan": "^1.11",
    "staabm/annotate-pull-request-from-checkstyle": "^1.8",
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "squizlabs/php_codesniffer": "^3.9",
    "wp-coding-standards/wpcs": "^3.0"
  },
  "autoload-dev": {
    "psr-4": {
      "Coinsnap\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "phpcs": "phpcs --standard=.phpcs.xml.dist",
    "phpcbf": "phpcbf --standard=.phpcs.xml.dist",
    "phpstan": "phpstan analyse -c phpstan.neon.dist",
    "format": "php-cs-fixer fix --config=.php-cs-fixer.php",
    "format:check": "php-cs-fixer fix --config=.php-cs-fixer.php --dry-run --diff"
  }
}
